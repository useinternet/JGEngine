+}
+
+void PGameUITimeline::Stop()
+{
+	if (_state != EState::Playing)
+	{
+		return;
+	}
+	_bCanceled = true;
+	finish(true);
+}
+
+void PGameUITimeline::Skip()
+{
+	if (_state != EState::Playing)
+	{
+		return;
+	}
+	// 남은 시간을 한꺼번에 준다: 트윈은 끝값, 기다리기는 넘기고, 함수는 차례대로. 끝없는 되풀이는 이번 바퀴 끝에서 멈춘다.
+	_bSkipping = true;
+	for (int32 guard = 0; guard < 100000 && _state == EState::Playing; ++guard)
+	{
+		tick(SkipSeconds);
+	}
+}
