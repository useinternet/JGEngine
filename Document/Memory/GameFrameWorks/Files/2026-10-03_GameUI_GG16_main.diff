+void PGameUITimeline::play(PGameUIManager* manager)
+{
+	if (_state == EState::Playing)
+	{
+		return;
+	}
+	resetCapture();
+	_manager   = manager;
+	_writerId  = ++GNextTweenWriterId;
+	_bChild    = false;
+	_state     = EState::Playing;
+	_iteration = 0;
+	_bReverse  = false;
+	_bSkipping = false;
+	resetIteration();
+	// 0초만큼 진행해 첫 트윈의 시작값을 바로 쓴다(재생을 건 프레임의 그리기가 시작값으로 나온다).
+	tick(0.0f);
+}
