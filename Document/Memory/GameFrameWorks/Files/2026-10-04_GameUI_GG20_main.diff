+bool PGameUIManager::routeWheel(const HList<PSharedPtr<JGGameWidget>>& widgets, const PSharedPtr<PGameUIElement>& hit, float32 wheel, float32 wheelHorizontal)
+{
+	if (wheel == 0.0f && wheelHorizontal == 0.0f)
+	{
+		return false;
+	}
+	for (const PSharedPtr<JGGameWidget>& widget : widgets)
+	{
+		HList<PSharedPtr<PGameUIScrollBox>> boxes;
+		if (collectScrollBoxesOnPath(widget->GetRoot(), hit.GetRawPointer(), boxes) == false)
+		{
+			continue;
+		}
+		// 가장 안쪽 칸부터. 그 방향으로 더 넘어갈 수 없는(끝에 닿은) 칸은 바깥 칸으로 넘긴다. 꺼진 칸은 받지 않는다.
+		for (auto it = boxes.rbegin(); it != boxes.rend(); ++it)
+		{
+			PSharedPtr<PGameUIScrollBox> box = *it;
+			if (box->IsEnabled() && box->handleWheel(wheel, wheelHorizontal))
+			{
+				return true;
+			}
+		}
+		return false;
+	}
+	return false;
+}
