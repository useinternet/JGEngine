+class PGameUIScrollBoxBar : public PGameUIElement
+{
+public:
+	PGameUIScrollBox* Box       = nullptr;   // 이 막대를 가진 칸(칸이 막대를 가지므로 칸이 먼저 사라지지 않는다)
+	bool              bVertical = true;
