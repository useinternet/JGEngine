+void HGUI::HighlightLine(const HLinearColor& InBackground, const HLinearColor& InAccent, float32 InAccentWidth)
+{
+	ImGuiWindow* Window = ImGui::GetCurrentWindow();
+	if (Window->SkipItems)
+	{
+		return;
+	}
+
