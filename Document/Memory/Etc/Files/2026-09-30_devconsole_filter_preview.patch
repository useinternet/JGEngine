+void JGDevConsole::syncCommandPreview(const PString& InText)
 {
-	return GetStaticGUID();
+	// ↑ 로 불러온 히스토리 줄을 고치면 히스토리 보기를 끝낸다. 다음 ↑ 는 가장 최근 줄부터다.
