+	const bool bChanged = ImGui::InputTextWithHint(InputTextKey.GetCStr(), InHint.GetCStr(), Buffer.data(), Buffer.capacity() + 1,
+		ImGuiInputTextFlags_CallbackResize, &inputTextResizeCallback, &Buffer);
+
+	if (InWidth != 0.0f)
+	{
+		ImGui::PopItemWidth();
+	}
+
+	if (bChanged)
+	{
+		InOutStr = Buffer.c_str();
+	}
+
+	return bChanged;
