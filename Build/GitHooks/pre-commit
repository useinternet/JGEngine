#!/usr/bin/env bash
# JGEngine 커밋 전 검사기 — 전체 필수 지침 8 · 엔진 지침서 2절 5번(2026-10-17, 엔진 총괄).
# 깔기: Build/GitHooks/install.sh (이 파일을 .git/hooks/pre-commit 으로 복사). 원본은 이 파일 하나다.
#
# 커밋에 들어가는(새로 · 고침 · 이름 바꿈) 파일 가운데 다음이 있으면 커밋을 막는다:
#   1. 사용자 메모         Document/Dashboard/사용자메모.md
#   2. 아컴호러(FFG) 자료  Document/아컴호러/ 아래 전부 — 이미 올라간 것은 그대로 두되 새로 넣거나 고쳐 넣지 않는다(결정함 H-002)
#   3. 실행 로그 · 덤프    이름이 jg_log.txt 인 파일, *.stackdump, Document/ 밖의 *.log (Document/Memory 의 증적 로그는 괜찮다)
#   4. 50MB 넘는 파일      GitHub 는 50MB 에서 경고, 100MB 에서 푸시를 거부한다
# 걸리면 억지로 넘기지 않는다(--no-verify 금지) — 그 파일을 빼고 다시 커밋하거나, 결정함에 보고한다.
# 파일을 지우는 커밋(D)은 막지 않는다(추적을 그만두는 git rm --cached 도 된다).

LIMIT=52428800
fail=0
list=$(mktemp)
git diff --cached --name-only --diff-filter=ACMR -z > "$list"

while IFS= read -r -d '' f; do
  reason=""
  case "$f" in
    "Document/Dashboard/사용자메모.md") reason="사용자 메모" ;;
    "Document/아컴호러/"*) reason="아컴호러(FFG) 자료 — 새로 넣거나 고쳐 넣지 않음(H-002)" ;;
    *.stackdump) reason="크래시 덤프" ;;
  esac
  if [ -z "$reason" ]; then
    base=${f##*/}
    if [ "$base" = "jg_log.txt" ]; then
      reason="실행 로그(jg_log.txt)"
    else
      case "$f" in
        Document/*) ;;
        *.log) reason="로그 파일(Document 밖)" ;;
      esac
    fi
  fi
  if [ -z "$reason" ]; then
    size=$(git cat-file -s ":$f" 2>/dev/null || echo 0)
    if [ "$size" -gt "$LIMIT" ]; then
      reason="50MB 넘음($(expr "$size" / 1048576)MB)"
    fi
  fi
  if [ -n "$reason" ]; then
    echo "[커밋 전 검사] 막음: $f — $reason" >&2
    fail=1
  fi
done < "$list"
rm -f "$list"

if [ "$fail" -ne 0 ]; then
  echo "[커밋 전 검사] 위 파일을 빼고(git restore --staged <파일>) 다시 커밋하세요. 억지로 넘기지 말고(--no-verify 금지) 필요하면 결정함에 보고합니다." >&2
  exit 1
fi
exit 0
